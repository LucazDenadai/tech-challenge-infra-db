# Copie este arquivo para terraform.tfvars antes de rodar o terraform apply
# O arquivo terraform.tfvars NÃO deve ser commitado (.gitignore já cobre)
#
# Credenciais abaixo são para ambiente local de desenvolvimento/estudo.
# Em produção, use senhas fortes e nunca exponha em repositórios.

db_name     = "oficinamecanica"
db_user     = "oficina"
db_password = "oficina@123"
db_port     = 5433

# Nome da rede Docker criada pelo cluster Kind — provisionado no repositório
# tech-challenge-infra-k8s. Deve ser aplicado DEPOIS daquele repositório.
kind_network = "kind"
